<!-------------Future use with Google API--------------->
<script async
        src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&libraries=places">
</script>

<script>

    const PRICE_PER_KM = 8;
    const MIN_FARE = 50;

    function calculateDistance() {

        const pickup =
            document.getElementById("pickup").value;

        const drop =
            document.getElementById("drop").value;

        const service =
            new google.maps.DistanceMatrixService();

        service.getDistanceMatrix(
        {
            origins: [pickup],
            destinations: [drop],
            travelMode: 'DRIVING',
            unitSystem: google.maps.UnitSystem.METRIC
        },

        function(response, status) {

            if (status !== 'OK') {
                alert('Error: ' + status);
                return;
            }

            const result =
                response.rows[0].elements[0];

            if (result.status !== "OK") {
                alert("No route found");
                return;
            }

            const distanceText =
                result.distance.text;

            const durationText =
                result.duration.text;

            const distanceValueKm =
                result.distance.value / 1000;

            let fare =
                distanceValueKm * PRICE_PER_KM;

            if (fare < MIN_FARE) {
                fare = MIN_FARE;
            }

            document.getElementById("distanceText")
                .innerHTML =
                "Distance: " + distanceText;

            document.getElementById("durationText")
                .innerHTML =
                "ETA: " + durationText;

            document.getElementById("fareText")
                .innerHTML =
                "Estimated Fare: ₹" +
                Math.round(fare);
        });
    }
</script>
<!--------Future use-------------->
<script>

    function initAutocomplete() {

        const pickup =
            new google.maps.places.Autocomplete(
                document.getElementById('pickup'));

        const drop =
            new google.maps.places.Autocomplete(
                document.getElementById('drop'));
    }

    google.maps.event.addDomListener(
        window,
        'load',
        initAutocomplete
    );

</script>
