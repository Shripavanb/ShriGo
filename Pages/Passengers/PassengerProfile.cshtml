@page
@model ShriGo.Pages.Passengers.PassengerProfileModel

@{
    ViewData["Title"] = "Passenger Profile";
}

<link href="~/css/riderprofile.css" rel="stylesheet" />

<div class="container py-4">

    @foreach (var activePassenger in Model.activePassenger)
    {
        <div class="card shadow border-0 rounded-4 mb-4">

            <div class="card-body p-4">

                <div class="row align-items-center">

                    <!-- Profile Image -->
                    <div class="col-lg-3 text-center mb-4 mb-lg-0">

                        <img src="@(string.IsNullOrEmpty(activePassenger.PassengerImagePath)
                                                 ? "/img/user.png"
                                                 : activePassenger.PassengerImagePath)"
                             class="img-fluid rounded-circle shadow-sm mb-3"
                             style="width:180px;height:180px;object-fit:cover;"
                             alt="Passenger Profile" />

                        <form method="post"
                              enctype="multipart/form-data"
                              asp-page-handler="UploadPhoto">

                            <div class="mb-2">

                                <input type="file"
                                       class="form-control"
                                       name="ProfileImage"
                                       accept=".jpg,.jpeg,.png" />

                            </div>

                            <button type="submit"
                                    class="btn btn-outline-primary btn-sm w-100">

                                Change Photo

                            </button>

                        </form>

                    </div>
                    <!-- Profile Details -->
                    <div class="col-lg-6">

                        <h2 class="fw-bold mb-1">
                            Welcome, @activePassenger.PassengerFirstName
                        </h2>

                        <p class="text-muted mb-3">
                            Passenger Account
                        </p>

                        <div class="row mb-2">
                            <div class="col-5 fw-bold">
                                User ID
                            </div>
                            <div class="col-7">
                                @activePassenger.PassengerUniqueId
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-5 fw-bold">
                                Full Name
                            </div>
                            <div class="col-7">
                                @activePassenger.PassengerFirstName
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-5 fw-bold">
                                Email
                            </div>
                            <div class="col-7 text-break">
                                @activePassenger.PassengerEmail
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-5 fw-bold">
                                Contact
                            </div>
                            <div class="col-7">
                                @activePassenger.PassengerContact
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-5 fw-bold">
                                Age
                            </div>
                            <div class="col-7">
                                @activePassenger.PassengerAge
                            </div>
                        </div>

                    </div>

                    <!-- Actions -->
                    <div class="col-lg-3 text-center">

                        <form method="post">
                            <button type="submit"
                                    asp-page-handler="BookRide"
                                    class="btn btn-primary btn-lg w-100 mb-3 shadow-sm">
                                🚗 Book Ride
                            </button>
                        </form>

                        <div class="card bg-light border-0 rounded-4">
                            <div class="card-body">
                                <h6 class="fw-bold">
                                    Passenger Status
                                </h6>

                                <span class="badge bg-success px-3 py-2">
                                    Active
                                </span>

                                <hr />

                                <p class="mb-1">
                                    Total Bookings
                                </p>

                                <h4 class="fw-bold">
                                    @Model.only_PassengerBookings.Count()
                                </h4>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>
    }

    <!-- Booking Section -->
    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0">
                    Your Bookings
                </h3>
            </div>

            @if (Model.only_PassengerBookings.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Date</th>
                                <th>From</th>
                                <th>To</th>
                                <th>Via</th>
                                <th>Time</th>
                                <th>Seats</th>
                                <th>Price</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var booking in Model.only_PassengerBookings)
                            {
                                <tr>

                                    <td>
                                        @booking.BookingId
                                    </td>

                                    <td>
                                        @booking.RideDate
                                    </td>

                                    <td>
                                        @booking.RideSource
                                    </td>

                                    <td>
                                        @booking.RideDesti
                                    </td>

                                    <td>
                                        @booking.RideVia
                                    </td>

                                    <td>
                                        @booking.RideTime
                                    </td>

                                    <td>
                                        @booking.BookedSeats
                                    </td>

                                    <td>
                                        ₹@booking.RidePrice
                                    </td>

                                    <td class="text-center">

                                        <form method="post"
                                              asp-page-handler="Delete"
                                              asp-route-id="@booking.BookingId">

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Delete this booking?')">

                                                Delete

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info rounded-4">
                    No bookings found.
                </div>
            }

        </div>

    </div>

</div>