@page
@model ShriGo.Pages.IndexModel

@{
    ViewData["Title"] = "ShriGo";
}

<link rel="stylesheet" href="~/css/index.css" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

<!-- HERO -->
<section class="hero">

    <div class="hero-content container">

        <h1 class="display-4 fw-bold">
            Welcome to ShriGo
        </h1>

        <h2 class="hero-subtitle">
            Affordable Rides. Trusted Drivers.
        </h2>

        <p class="hero-text">
            Book rides or earn by driving with ShriGo
        </p>

        <div class="d-flex flex-column flex-md-row gap-3 justify-content-center">

            <a href="#ride-section"
                   class="btn btn-primary btn-lg rounded-pill px-4">

                Book a Ride

            </a>

            <a href="/SignUp"
                   class="btn btn-outline-light btn-lg rounded-pill px-4">

                Become a Driver

            </a>

        </div>

    </div>

</section>

<!-- BOOKING -->
<!-- BOOKING -->
<div class="container booking-wrapper">

    <div class="booking-card">

        <h3 class="booking-title">
            Find Your Ride
        </h3>

        <div class="row g-3">

            <div class="col-12 col-md-5">

                <label class="form-label booking-label">
                    Pickup
                </label>

                <select name="pickup"
                        class="form-select booking-select"
                        id="pickup">

                    <option hidden>Choose Pickup</option>

                    <option value="HYD">Hyd</option>
                    <option value="JBS">JBS</option>
                    <option value="Airport">Airport</option>
                    <option value="MTPL">MTPL</option>
                    <option value="KRTL">KRTL</option>
                    <option value="KRTL">RYKL</option>
                    <option value="ARMR">ARMR</option>
                    <option value="NZB">NZB</option>
                    <option value="JBS,HYD">JBS,HYD</option>
                    <option value="JBS,Airport">JBS,Airport</option>
                    <option value="JBS,HYD,Airport">JBS,HYD,Airport</option>
                    <option value="KRTL,MTPL">KRTL,MTPL</option>
                    <option value="RYKL,KRTL,MTPL">RYKL,KRTL,MTPL</option>

                </select>

            </div>

            <div class="col-12 col-md-5">

                <label class="form-label booking-label">
                    Drop
                </label>

                <select name="drop"
                        class="form-select booking-select"
                        id="drop">

                    <option hidden>Choose Drop</option>

                    <option value="HYD">Hyd</option>
                    <option value="JBS">JBS</option>
                    <option value="Airport">Airport</option>
                    <option value="MTPL">MTPL</option>
                    <option value="KRTL">KRTL</option>
                    <option value="KRTL">RYKL</option>
                    <option value="ARMR">ARMR</option>
                    <option value="NZB">NZB</option>
                    <option value="JBS,HYD">JBS,HYD</option>
                    <option value="JBS,Airport">JBS,Airport</option>
                    <option value="JBS,HYD,Airport">JBS,HYD,Airport</option>
                    <option value="KRTL,MTPL">KRTL,MTPL</option>
                    <option value="RYKL,KRTL,MTPL">RYKL,KRTL,MTPL</option>

                </select>

            </div>

            <div class="col-12 col-md-2 d-flex align-items-end">

                <button type="button"
                        onclick="goToBookRide()"
                        class="btn booking-btn w-100">

                    Check Price & Book

                </button>

            </div>

        </div>

    </div>

</div>

<!-- ACTIVE RIDES -->
<div class="container py-4" id="ride-section">

    <div class="text-center mb-4">

        <hr class="border border-success border-2 opacity-100">

        <h2 class="fw-bold">
            Active Rides
        </h2>

        <hr class="border border-success border-2 opacity-100">

    </div>

    @{
        var sortedtime = "00:00am";
    }

    @foreach (ShriGo.Model.SortedRideModel rideModel in Model.finalListRideModel)
    {
        if (rideModel.RideTime != null)
        {
            string time24 = rideModel.RideTime.ToString();

            DateTime parsedTime = DateTime.Parse(time24);

            sortedtime = parsedTime.ToString("hh:mm tt");
        }

        <div class="card shadow-sm border-0 mb-4 ride-card">

            <div class="card-body p-3">

                <!-- TOP -->
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">

                    <div>

                        <div class="fw-bold fs-5">

                            @if (rideModel.RideSource.Contains("Airport"))
                            {
                                <img src="~/img/flightimg1.png"
                                     width="28"
                                     class="me-1" />

                                <span>@rideModel.RideSource</span>
                            }
                            else
                            {
                                <span>@rideModel.RideSource</span>
                            }

                        </div>

                        <small class="text-success fw-semibold">

                            @if (rideModel.RideDate == DateOnly.FromDateTime(DateTime.UtcNow))
                            {
                                <span>Today</span>
                            }
                            else if (rideModel.RideDate == DateOnly.FromDateTime(DateTime.UtcNow).AddDays(1))
                            {
                                <span>Tomorrow</span>
                            }
                            else
                            {
                                <span>@rideModel.RideDate</span>
                            }

                            • @sortedtime

                        </small>

                    </div>

                    <a href="https://wa.me/?text=@Model.GetWhatsAppShareText(rideModel)"
                           target="_blank"
                           class="btn btn-success btn-sm rounded-3">

                        <i class="bi bi-share-fill"></i>

                    </a>

                </div>

                <hr>

                <!-- VIA + PRICE -->
                <div class="d-flex justify-content-between flex-wrap gap-3">

                    <div class="location-text">

                        <small class="text-muted">
                            Via
                        </small>

                        <div>
                            @rideModel.RideVia
                        </div>

                    </div>

                    <div class="text-end">

                        <small class="text-muted">
                            Price
                        </small>

                        <div class="fw-bold text-success fs-5">

                            ₹@rideModel.RidePrice

                            <small>/seat</small>

                        </div>

                    </div>

                </div>

                <hr>

                <!-- DESTINATION -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                    <div class="d-flex align-items-center gap-2">

                        @if (rideModel.RideDesti.Contains("Airport"))
                        {
                            <img src="~/img/flightimg1.png"
                                 width="28" />
                        }

                        <span class="fw-semibold">
                            @rideModel.RideDesti
                        </span>

                    </div>

                    <div>

                        <img src="~/img/seaticon.png"
                             style="width:18px;height:18px;" />

                        <span class="fw-semibold">
                            @rideModel.RideSeats Seats
                        </span>

                    </div>

                </div>

                <!-- BUTTONS -->
                <div class="row mt-3 g-2">

                    <div class="col-12 col-md-6">

                        <a asp-page="./Booking/BookRide"
                               asp-route-id="@rideModel.RideId"
                               class="btn btn-primary w-100 rounded-3">

                            Book Ride

                        </a>

                    </div>

                    <div class="col-12 col-md-6">

                        <a href="tel:@rideModel.DriverContact"
                               class="btn btn-success w-100 rounded-3">

                            @rideModel.DriverContact

                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>

<!-- EXPIRED RIDES -->
<div class="container py-4">

    <div class="text-center mb-4">

        <hr class="border border-danger border-2 opacity-100">

        <h2 class="fw-bold text-danger">
            Started / Expired Rides
        </h2>

        <hr class="border border-danger border-2 opacity-100">

    </div>

    @{
        var lsortedtime = "00:00am";
    }

    @foreach (ShriGo.Model.SortedRideModel rideModel in Model.expiredRidesList)
    {
        if (rideModel.RideTime != null)
        {
            string time24 = rideModel.RideTime.ToString();

            DateTime parsedTime = DateTime.Parse(time24);

            lsortedtime = parsedTime.ToString("hh:mm tt");
        }

        <div class="card shadow-sm border-0 mb-4 ride-card opacity-75">

            <div class="card-body p-3">

                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">

                    <div>

                        <div class="fw-bold fs-5">

                            @if (rideModel.RideSource.Contains("Airport"))
                            {
                                <img src="~/img/flightimg1.png"
                                     width="28"
                                     class="me-1" />
                            }

                            @rideModel.RideSource

                        </div>

                        <small class="text-danger fw-semibold">

                            @if (rideModel.RideDate == DateOnly.FromDateTime(DateTime.UtcNow))
                            {
                                <span>Today</span>
                            }
                            else if (rideModel.RideDate == DateOnly.FromDateTime(DateTime.UtcNow).AddDays(1))
                            {
                                <span>Tomorrow</span>
                            }
                            else
                            {
                                <span>@rideModel.RideDate</span>
                            }

                            • @lsortedtime

                        </small>

                    </div>

                </div>

                <hr>

                <div class="d-flex justify-content-between flex-wrap gap-3">

                    <div class="location-text">

                        <small class="text-muted">
                            Via
                        </small>

                        <div>
                            @rideModel.RideVia
                        </div>

                    </div>

                    <div class="text-end">

                        <small class="text-muted">
                            Price
                        </small>

                        <div class="fw-bold text-danger fs-5">

                            ₹@rideModel.RidePrice

                            <small>/seat</small>

                        </div>

                    </div>

                </div>

                <hr>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                    <div class="d-flex align-items-center gap-2">

                        @if (rideModel.RideDesti.Contains("Airport"))
                        {
                            <img src="~/img/flightimg1.png"
                                 width="28" />
                        }

                        <span class="fw-semibold">
                            @rideModel.RideDesti
                        </span>

                    </div>

                    <div>

                        <img src="~/img/seaticon.png"
                             style="width:18px;height:18px;" />

                        <span class="fw-semibold">
                            @rideModel.RideSeats Seats
                        </span>

                    </div>

                </div>

            </div>

        </div>
    }

</div>

<!-- TRUST -->
<section class="trust">

    <div>✔ Verified Drivers</div>

    <div>✔ Aadhaar Verified</div>

    <div>✔ Safe & Secure</div>

    <div>✔ 24/7 Support</div>

</section>

<!-- HOW IT WORKS -->
<section class="steps">

    <h2 class="fw-bold mb-5">
        How ShriGo Works
    </h2>

    <h4>
        Booking from available rides
    </h4>

    <div class="step-grid mb-5">

        <div class="step">
            1. View Active Rides
        </div>

        <div class="step">
            2. Choose Your Ride
        </div>

        <div class="step">
            3. Call Driver / Book Ride
        </div>

    </div>

    <h4>
        Book your desired ride
    </h4>

    <div class="step-grid">

        <div class="step">
            1. Enter Pickup & Drop
        </div>

        <div class="step">
            2. Choose Your Ride
        </div>

        <div class="step">
            3. Travel Safely
        </div>

    </div>

</section>

<!-- DRIVER CTA -->
<section class="driver">

    <h2 class="fw-bold">
        Earn with ShriGo
    </h2>

    <p>
        Join as a driver and earn daily income
    </p>

    <a href="/SignUp">

        <button class="btn btn-primary btn-lg rounded-pill px-4">

            Start Driving

        </button>

    </a>

</section>

<!-- ANALYTICS -->
<div class="container">

    <div class="dashboard">

        <div class="card d-none">

            <div class="label">
                👀 Active Users
            </div>

            <div id="activeUsers" class="value">
                0
            </div>

        </div>

        <div class="card">

            <div class="label">
                📄 Site Views
            </div>

            <div id="pageViews" class="value">
                0
            </div>

        </div>

        <div class="card d-none">

            <div class="label">
                👥 Total Users
            </div>

            <div id="totalUsers" class="value">
                0
            </div>

        </div>

    </div>

</div>

<!-- ANALYTICS SCRIPT -->
<script>
    async function fetchUsers() {

        const res = await fetch('/api/analytics/dashboard');

        const data = await res.json();

        document.getElementById('activeUsers').innerText =
            (data.activeUsers ?? 0) + " Users Online";

        document.getElementById('pageViews').innerText =
            (data.pageViews ?? 0) + " Site Views";

        document.getElementById('totalUsers').innerText =
            (data.totalUsers ?? 0) + " Total Users";
    }

    setInterval(fetchUsers, 10000);

    fetchUsers();
</script>

<!-- GOOGLE TAG -->
<script async
        src="https://www.googletagmanager.com/gtag/js?id=G-4PQX2FTGWX">
</script>

<script>
    window.dataLayer = window.dataLayer || [];

    function gtag() {
        dataLayer.push(arguments);
    }

    gtag('js', new Date());

    gtag('config', 'G-4PQX2FTGWX');
</script>

<!-- BOOK RIDE -->
<script>

    function goToBookRide() {

        const pickup =
            document.getElementById("pickup").value;

        const drop =
            document.getElementById("drop").value;

        if (!pickup || !drop) {

            alert("Please select pickup and drop");

            return;
        }

        window.location.href =
            `/Booking/CheckAndBookRide?pickup=${encodeURIComponent(pickup)}&drop=${encodeURIComponent(drop)}`;
    }

</script>