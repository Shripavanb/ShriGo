<script>

    function searchRide() {

        const pickup =

            document
                .getElementById(
                    "pickup"
                )
                .value
                .trim();

        const drop =

            document
                .getElementById(
                    "drop"
                )
                .value
                .trim();

        if (
            !pickup ||
            !drop
        ) {

            alert(
                "Please enter pickup and drop"
            );

            return;
        }

        window.location.href =

            `/?pickup=${encodeURIComponent(pickup)}&drop=${encodeURIComponent(drop)}`;
    }


    function clearSearch() {

        document
            .getElementById(
                "pickup"
            )
            .value = "";

        document
            .getElementById(
                "drop"
            )
            .value = "";

        window.location.href = "/";
    }



</script>