<!DOCTYPE html>
@using Microsoft.AspNetCore.Http

<html lang="en">

<head>

    <!-- =========================================
         META
    ========================================== -->

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <!-- =========================================
         SEO
    ========================================== -->

    <title>@ViewData["Title"] - ShriGo.in</title>

    <meta name="description"
          content="ShriGo.in - Premium Car Pickup and Drop Service. Fast, reliable and professional rides." />

    <!-- =========================================
         OPEN GRAPH / WHATSAPP
    ========================================== -->

    <meta property="og:title"
          content="ShriGo.in - Premium Car Service" />

    <meta property="og:description"
          content="Book premium car pickup and drop services with ShriGo.in." />

    <meta property="og:url"
          content="https://shrigo.in/" />

    <meta property="og:type"
          content="website" />

    <meta property="og:image"
          content="https://shrigo.in/img/Logo/shrigo_share_banner.png" />

    <meta property="og:image:width"
          content="1200" />

    <meta property="og:image:height"
          content="630" />

    <meta property="og:image:type"
          content="image/png" />

    <!-- =========================================
         TWITTER / IOS PREVIEW
    ========================================== -->

    <meta name="twitter:card"
          content="summary_large_image" />

    <!-- =========================================
         FAVICON
    ========================================== -->

    <link rel="icon"
          type="image/png"
          href="~/img/Logo/FinalLogo.png" />

    <!-- =========================================
         BOOTSTRAP CSS
    ========================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- =========================================
         BOOTSTRAP ICONS
    ========================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- =========================================
         SITE CSS
    ========================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- =========================================
         JQUERY
    ========================================== -->

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

</head>

<body>

    <!-- =========================================
         HEADER
    ========================================== -->

    <header>

        <nav class="navbar navbar-expand-sm navbar-light shrigo-navbar sticky-top">

            <div class="container">

                <!-- =========================================
                     LOGO
                ========================================== -->

                <a class="navbar-brand d-flex align-items-center"
                       asp-page="/Index">

                    <img src="~/img/Logo/FinalLogo.png"
                         alt="ShriGo Logo"
                         class="shrigo-logo" />

                    <div class="ms-2">

                        <div class="shrigo-brand-text">
                            ShriGo.in
                        </div>

                        <div class="shrigo-tagline">
                            PREMIUM CAR SERVICE
                        </div>

                    </div>

                </a>

                <!-- =========================================
                     MOBILE TOGGLE
                ========================================== -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#shrigoNavbar"
                        aria-controls="shrigoNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- =========================================
                     NAVIGATION
                ========================================== -->

                <div class="collapse navbar-collapse"
                     id="shrigoNavbar">

                    <ul class="navbar-nav ms-auto align-items-center">

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-page="/Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-page="/Privacy">
                                Privacy
                            </a>
                        </li>

                        @{
                            var username = Context.Session.GetString("session_UserName");
                            var userRole = Context.Session.GetString("session_UserRole");
                            var passengerRole = Context.Session.GetString("session_PassengerRole");
                        }

                        @if (string.IsNullOrEmpty(username))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                       asp-page="/SignIn">
                                    Sign In
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                       asp-page="/SignUp">
                                    Sign Up
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="nav-link fw-bold text-primary">
                                    Welcome, @username
                                </span>
                            </li>

                            @if (userRole == "Driver")
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                           asp-page="/RiderProfile">
                                        My Profile
                                    </a>
                                </li>
                            }
                            else if (userRole == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                           asp-page="/Admin/AdminDashboard">
                                        Admin
                                    </a>
                                </li>
                            }
                            else if (passengerRole == "Passenger")
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                           asp-page="/Passengers/PassengerProfile">
                                        My Profile
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link text-danger"
                                       asp-page="/SignOut">
                                    Sign Out
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <!-- =========================================
         MAIN BODY
    ========================================== -->

    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>

    <br />
    <br />
    <br />

    <!-- =========================================
         REFERENCE SECTION
    ========================================== -->

    <div class="container-fluid referencebg">

        <div class="container py-4">

            <div class="row">

                <!-- =========================================
                     LOGO & ADDRESS
                ========================================== -->

                <div class="col-md-3">

                    <img src="~/img/Logo/FinalLogo.png"
                         alt="ShriGo Logo"
                         class="footer-logo" />

                    <p class="mt-3">
                        <i class="bi bi-geo-alt-fill text-warning"></i>
                        Spring Fields Colony, Jeedimetla
                    </p>

                    <p>
                        Hyderabad, Telangana 500067, India
                    </p>

                </div>

                <!-- =========================================
                     SOCIAL MEDIA
                ========================================== -->

                <div class="col-md-3">

                    <h3>Media</h3>

                    <hr />

                    <ul>

                        <li>
                            <a href="#"
                                   class="icon-link">
                                <i class="bi bi-linkedin"></i> LinkedIn
                            </a>
                        </li>

                        <li>
                            <a href="https://www.instagram.com/shriaitech?igsh=MThicHV3NnVzMWlzZA=="
                                   target="_blank"
                                   class="icon-link">

                                <i class="bi bi-instagram"></i> Instagram

                            </a>
                        </li>

                        <li>
                            <a href="#"
                                   class="icon-link">
                                <i class="bi bi-twitter-x"></i> Twitter
                            </a>
                        </li>

                        <li>
                            <a href="#"
                                   class="icon-link">
                                <i class="bi bi-facebook"></i> Facebook
                            </a>
                        </li>

                    </ul>

                </div>

                <!-- =========================================
                     COMPANY
                ========================================== -->

                <div class="col-md-3">

                    <h3>Company</h3>

                    <hr />

                    <ul>

                        <li>
                            <a class="nav-link text-dark"
                                   asp-page="/Index">
                                Home
                            </a>
                        </li>

                        <li>
                            <a class="nav-link text-dark"
                                   asp-page="/Privacy">
                                Privacy
                            </a>
                        </li>

                        <li>
                            <a class="nav-link text-dark"
                                   asp-page="/ContactUs">
                                Contact Us
                            </a>
                        </li>

                        <li>
                            <a class="nav-link text-dark"
                                   asp-page="/AboutUs">
                                About Us
                            </a>
                        </li>

                    </ul>

                </div>

                <!-- =========================================
                     CONTACT
                ========================================== -->

                <div class="col-md-3">

                    <h3>Contact</h3>

                    <hr />

                    <ul>

                        <li>
                            <i class="bi bi-telephone-fill"></i>
                            +91 8374499001
                        </li>

                        <li>
                            <i class="bi bi-envelope-fill"></i>
                            shripavanb@shrigo.in
                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

    <!-- =========================================
         FOOTER
    ========================================== -->

    <footer class="border-top footer text-muted">

        <div class="container py-3">

            &copy; 2025 - ShriGo -
            Powered by

            <a href="https://shriaitech.in/"
                   target="_blank">

                shriaitech.in

            </a>

        </div>

    </footer>

    <!-- =========================================
         SCRIPTS
    ========================================== -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>