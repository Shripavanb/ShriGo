@page
@model ShriGo.Pages.ForgotPasswordModel

<div class="container mt-5">

    <div class="card p-4 shadow">

        <h3>Forgot Password</h3>

        <form method="post">

            <div class="form-group mb-3">
                <label>Email</label>

                <input type="email"
                       class="form-control"
                       asp-for="Email" />
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Send Reset Link
            </button>

        </form>

    </div>

</div>