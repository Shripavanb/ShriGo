@page
@model ShriGo.Pages.RiderProfileModel

@{
    ViewData["Title"] = "Driver Profile";
}

<link href="~/css/riderprofile.css" rel="stylesheet" />

<div class="container py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @foreach (var activeuser in Model.activeUser)
    {
        <div class="card shadow border-0 rounded-4 mb-4">

            <div class="card-body p-4">

                <div class="row align-items-center">

                    <!-- Profile Image -->
                    <div class="col-lg-3 text-center mb-4 mb-lg-0">

                        <img src="@(string.IsNullOrEmpty(activeuser.UserImagePath)
                                                                                     ? "/img/user.png"
                                                                                     : activeuser.UserImagePath)"
                             class="img-fluid rounded-circle shadow-sm mb-3"
                             style="width:180px;height:180px;object-fit:cover;"
                             alt="Driver Profile" />

                        <form method="post"
                              enctype="multipart/form-data"
                              asp-page-handler="UploadPhoto">

                            <div class="mb-2">

                                <input type="file"
                                       class="form-control"
                                       name="ProfileImage"
                                       accept=".jpg,.jpeg,.png" />

                            </div>

                            <button type="submit"
                                    class="btn btn-outline-primary btn-sm w-100">

                                Change Photo

                            </button>

                        </form>

                    </div>

                    <!-- Profile Details -->
                    <div class="col-lg-6">

                        <h2 class="fw-bold mb-1">
                            Welcome, @activeuser.UserFirstName
                        </h2>

                        <p class="text-muted mb-3">
                            Cab Driver / Cab Owner
                        </p>

                        <div class="row mb-2">
                            <div class="col-5 fw-bold">
                                User ID
                            </div>

                            <div class="col-7">
                                @activeuser.UserUniqueId
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-5 fw-bold">
                                Name
                            </div>

                            <div class="col-7">
                                @activeuser.UserFirstName
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-5 fw-bold">
                                Email
                            </div>

                            <div class="col-7 text-break">
                                @activeuser.UserEmail
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-5 fw-bold">
                                Contact
                            </div>

                            <div class="col-7">
                                @activeuser.UserContact
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-5 fw-bold">
                                Role
                            </div>

                            <div class="col-7">
                                @activeuser.UserRole
                            </div>
                        </div>

                    </div>

                    <!-- Action Buttons -->
                    <div class="col-lg-3 text-center">

                        <form method="post">

                            <button type="submit"
                                    asp-page-handler="UploadRide"
                                    class="btn btn-primary btn-lg w-100 mb-3 shadow-sm">

                                🚗 Upload Ride

                            </button>

                        </form>

                        <div class="card bg-light border-0 rounded-4">

                            <div class="card-body">

                                <h6 class="fw-bold">
                                    Driver Status
                                </h6>

                                <span class="badge bg-success px-3 py-2">
                                    Active
                                </span>

                                <hr />

                                <p class="mb-1">
                                    Total Rides
                                </p>

                                <h4 class="fw-bold">
                                    @Model.only_DriverRides.Count()
                                </h4>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    }

    <!-- Ride Table -->
    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h3 class="fw-bold mb-0">
                    Your Rides
                </h3>

            </div>

            @if (Model.only_DriverRides.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>Id</th>
                                <th>Date</th>
                                <th>From</th>
                                <th>To</th>
                                <th>Via</th>
                                <th>Time</th>
                                <th>Seats</th>
                                <th>Price</th>
                                <th class="text-center">
                                    Actions
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var ride in Model.only_DriverRides)
                            {
                                <tr>

                                    <td>
                                        @ride.RideId
                                    </td>

                                    <td>
                                        @ride.RideDate
                                    </td>

                                    <td>
                                        @ride.RideSource
                                    </td>

                                    <td>
                                        @ride.RideDesti
                                    </td>

                                    <td>
                                        @ride.RideVia
                                    </td>

                                    <td>
                                        @ride.RideTime
                                    </td>

                                    <td>
                                        @ride.RideSeats
                                    </td>

                                    <td>
                                        ₹@ride.RidePrice
                                    </td>

                                    <td>

                                        <div class="d-flex gap-2 justify-content-center">

                                            <!-- Delete -->
                                            <form method="post"
                                                  asp-page-handler="Delete"
                                                  asp-route-id="@ride.RideId">

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Delete this ride?')">

                                                    Delete

                                                </button>

                                            </form>

                                            <!-- Edit -->
                                            <a asp-page="./Drivers/Edit"
                                                   asp-route-id="@ride.RideId"
                                                   class="btn btn-sm btn-primary">

                                                Edit

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info rounded-4">
                    No rides uploaded yet.
                </div>
            }

        </div>

    </div>

</div>